# Cloud Run container args and env vars for evals on the agent service.
# Dockerfile CMD must use the same sublauncher args as Cloud Run.
#
# Append "evals" to existing args — preserve other sublaunchers (webui, api, agui, lro, scheduler).
# Mirror application env vars on google_vertex_ai_reasoning_engine.spec.deployment_spec
# when the same image runs on Agent Engine. GOOGLE_CLOUD_* vars are Cloud Run only.

containers {
  command = ["/app/main"]
  args    = ["web", "-port", "8080", "webui", "-api_server_address=/api", "api", "agui", "evals"]

  env {
    name  = "AGENT_EVALS_BUCKET"
    value = google_storage_bucket.agent-evals.name
  }
  env {
    name  = "ALIS_OS_PROJECT"
    value = var.ALIS_OS_PROJECT
  }
  env {
    name  = "ALIS_REGION"
    value = var.ALIS_REGION
  }
  env {
    name  = "GOOGLE_CLOUD_PROJECT"
    value = var.ALIS_PROJECT_NR
  }
  env {
    name  = "GOOGLE_CLOUD_LOCATION"
    value = var.ALIS_REGION
  }
}

# Dockerfile example (must match args above):
# CMD ["/app/main", "web", "-port", "8080", "webui", "-api_server_address=/api", "api", "agui", "evals"]
