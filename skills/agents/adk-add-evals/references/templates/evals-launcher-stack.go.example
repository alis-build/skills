// Greenfield reference ONLY — Pattern A: launcher stack.
// Do not copy paths blindly. Add webevals.NewLauncher beside existing sublaunchers
// inside the repo's existing web.NewLauncher(...) call.
//
// ADK v2: google.golang.org/adk/v2/... + launchers v1.0.0+ (v1.0.10+ for evals)
// ADK pre-v2: google.golang.org/adk/... + launchers pre-v1.0.0 (v0.3.10+ for evals)

import (
	"log"
	"os"

	evalmetrics "REPLACE_WITH_YOUR_MODULE/internal/evals/metrics"
	webevals "go.alis.build/adk/launchers/evals"
	launchersweb "go.alis.build/adk/launchers/web"
	"google.golang.org/adk/v2/cmd/launcher/universal"
	"google.golang.org/genai"
)

func wireLauncherStack(ctx context.Context, launcherConfig *launcher.Config, geminiCfg genai.ClientConfig) {
	judgeGenaiClient, err := genai.NewClient(ctx, &geminiCfg)
	if err != nil {
		log.Fatalf("Failed to create judge genai client: %v", err)
	}

	evalsOpts := []webevals.Option{
		webevals.WithMetricRegistry(evalmetrics.NewRegistry(judgeGenaiClient, evalmetrics.DefaultJudgeModel)),
	}
	if bucket := os.Getenv("AGENT_EVALS_BUCKET"); bucket != "" {
		evalsOpts = append(evalsOpts, webevals.WithEvalStorageURI("gs://"+bucket))
	}
	// Standard: wire WithEvalStorageURI from AGENT_EVALS_BUCKET (local .env too).
	// WithAgentsDir / CLI -agents_dir only when user explicitly requests local disk storage.

	l := universal.NewLauncher(launchersweb.NewLauncher(
		// ... existing sublaunchers ...
		webevals.NewLauncher(evalsOpts...),
	))
	// l.Execute(ctx, launcherConfig, os.Args[1:])
}

// Deployment: append "evals" to CLI args (no -agents_dir unless user asked for local disk).
