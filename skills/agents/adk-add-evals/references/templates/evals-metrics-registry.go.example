// Greenfield reference ONLY — judge-backed metric registry contract.
// Discover existing packages first; create new package only when nothing owns eval metrics.

package metrics

import (
	"context"
	"fmt"

	"go.alis.build/adk/launchers/evals/evaluation/metrics"
	"go.alis.build/adk/launchers/evals/evaluation/models"
	"google.golang.org/genai"
)

const DefaultJudgeModel = "gemini-2.5-flash"

func NewRegistry(client *genai.Client, defaultJudgeModel string) *metrics.Registry {
	if defaultJudgeModel == "" {
		defaultJudgeModel = DefaultJudgeModel
	}
	r := metrics.NewDefaultRegistry()
	r.SetConfig(metrics.RegistryConfig{
		JudgeClient: &geminiJudge{client: client, defaultModel: defaultJudgeModel},
	})
	return r
}

type geminiJudge struct {
	client       *genai.Client
	defaultModel string
}

func (j *geminiJudge) GenerateJudgeResponse(
	ctx context.Context,
	prompt string,
	opts models.JudgeModelOptions,
) (string, error) {
	if j == nil || j.client == nil {
		return "", fmt.Errorf("gemini judge: client is nil")
	}
	model := opts.JudgeModel
	if model == "" {
		model = j.defaultModel
	}
	contents := []*genai.Content{{
		Role:  "user",
		Parts: []*genai.Part{{Text: prompt}},
	}}
	resp, err := j.client.Models.GenerateContent(ctx, model, contents, opts.JudgeModelConfig)
	if err != nil {
		return "", fmt.Errorf("gemini judge: generate (%s): %w", model, err)
	}
	return resp.Text(), nil
}
